# ── LLM ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_PROVIDER=gemini          # gemini | anthropic | ollama

# ── Transcription ─────────────────────────────────────────
WHISPER_MODEL=base           # base | small | medium | large-v3
WHISPER_DEVICE=cpu           # cpu | cuda
WHISPER_COMPUTE=int8         # int8 | float16 | float32

# ── Pipeline Defaults ─────────────────────────────────────
CLIP_MIN_DURATION=20         # seconds
CLIP_MAX_DURATION=90         # seconds
TOP_N_CLIPS=10
OUTPUT_DIR=./output
FFMPEG_PATH=./bin/ffmpeg     # path to static binary or system ffmpeg

# ── Prototype Logging ─────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING
